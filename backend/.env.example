# CAIP-Karnataka Backend — Environment Variables
# Copy to .env for local (non-Docker) development.
# When running via docker-compose, these are already set as
# environment: entries in docker-compose.yml and this file is not read.

APP_NAME=CAIP - Karnataka Crime Intelligence Platform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-byte-string

# Must be valid JSON array syntax, as a string, matching the
# docker-compose ALLOWED_ORIGINS quoting fix.
ALLOWED_ORIGINS=["http://localhost:5173"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caip_karnataka
POSTGRES_USER=caip
POSTGRES_PASSWORD=caip_secret

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
